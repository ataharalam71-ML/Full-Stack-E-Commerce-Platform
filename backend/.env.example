# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (required) ───────────────────────────────────────────────────────
# Free Postgres: create a project at https://neon.tech and copy its connection string.
# A file-based database cannot be used in production: free hosts wipe the disk on every
# restart, which deletes your deals.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ── Admin login ───────────────────────────────────────────────────────────────
# Used by "npm run seed" to create the first (and only) admin account.
ADMIN_NAME=Site Owner
ADMIN_EMAIL=admin@dealdost.com
ADMIN_PASSWORD=Admin@123

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ── Your affiliate IDs (also editable in Admin -> Settings) ────────────────────
# Amazon Associates India -> https://affiliate-program.amazon.in  (looks like: yourname-21)
AMAZON_TAG=
# Flipkart Affiliate -> https://affiliate.flipkart.com  (your tracking/affiliate ID)
FLIPKART_AFFID=
# Meesho has no public affiliate API. Use links from your Meesho partner dashboard or
# from EarnKaro/INRDeals; this value is only added as utm_source for your own reporting.
MEESHO_TAG=

# ── Frontend / SEO ────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:3000
# Public URL of the site, used to build sitemap.xml
SITE_URL=http://localhost:3000

# Seconds to cache deal listings in memory (Redis is not needed)
CACHE_TTL_SECONDS=60

# -- AI finder (optional) -----------------------------------------------------
# Powers Admin -> AI finder: type "t shirt", it searches Amazon/Flipkart/Meesho and
# proposes deals for you to approve. Leave both keys blank to hide the feature.
#
# FREE option (recommended) - Groq. No card needed: https://console.groq.com/keys
GROQ_API_KEY=
#
# PAID option - Claude. Better results, costs a few cents per search.
# https://console.anthropic.com
ANTHROPIC_API_KEY=
#
# Which one to use. Leave blank to pick automatically (Groq first, since it is free).
# Set to "groq" or "anthropic" to pin one.
AI_PROVIDER=
#
# Model overrides - only needed if Groq renames a model. Defaults shown.
# GROQ_SEARCH_MODEL=groq/compound
# GROQ_FORMAT_MODEL=openai/gpt-oss-120b
# ANTHROPIC_MODEL=claude-opus-5
