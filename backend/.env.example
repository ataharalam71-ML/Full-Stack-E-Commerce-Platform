# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (required) ───────────────────────────────────────────────────────
# Free Postgres: create a project at https://neon.tech and copy its connection string.
# A file-based database cannot be used in production: free hosts wipe the disk on every
# restart, which deletes your deals.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ── Admin login ───────────────────────────────────────────────────────────────
# Used by "npm run seed" to create the first (and only) admin account.
ADMIN_NAME=Site Owner
ADMIN_EMAIL=admin@dealdost.com
ADMIN_PASSWORD=Admin@123

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ── Your affiliate IDs (also editable in Admin -> Settings) ────────────────────
# Amazon Associates India -> https://affiliate-program.amazon.in  (looks like: yourname-21)
AMAZON_TAG=
# Flipkart Affiliate -> https://affiliate.flipkart.com  (your tracking/affiliate ID)
FLIPKART_AFFID=

# ── Frontend / SEO ────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:3000
# Public URL of the site, used to build sitemap.xml
SITE_URL=http://localhost:3000

# Seconds to cache deal listings in memory (Redis is not needed)
CACHE_TTL_SECONDS=60

# -- Product finder (Admin -> Find products) ----------------------------------
# No API key and no account needed: the finder reads the stores' own pages.
# These only need changing if a store starts rate-limiting you.
# FINDER_TIMEOUT_MS=20000      # give up on a store after this long
# FINDER_CACHE_TTL_MS=600000   # reuse a fetched page for 10 minutes
# FINDER_MIN_GAP_MS=700        # minimum gap between two requests to the same store
